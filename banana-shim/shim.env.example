# banana-shim 自身配置(和 EASEL 的 .env 是两回事)

# 用哪个后端: gemini | flow | mock
BANANA_BACKEND=mock

BANANA_HOST=127.0.0.1
BANANA_PORT=8790

# gemini 后端要用(到 aistudio.google.com/apikey 取)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# flow 后端要用
FLOW_URL=https://labs.google/fx/tools/flow
FLOW_TIMEOUT=240
