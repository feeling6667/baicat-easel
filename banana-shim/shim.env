# banana-shim 配置。改完重启 shim 生效。
# 后端三选一: gemini(官方 API) | flow(网页, 用订阅) | mock(占位)
BANANA_BACKEND=arena

BANANA_HOST=127.0.0.1
BANANA_PORT=8790

# gemini 后端用: 到 aistudio.google.com/apikey 取
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# flow 后端用
FLOW_URL=https://flow.google.com/
FLOW_TIMEOUT=240
